# theloop-specific hardware overlay
# Applied on top of: mediatek-bazel_defconfig + mt6877_overlay
# (sec_ogki_fragment and mt6877_teegris_5 overlays intentionally omitted from build_kernel.sh)

# RT5512 audio amplifier (theloop uses this)
CONFIG_SND_SOC_RT5512=m

# Extra insurance: ensure Samsung-GKI handoff expectation is off
# CONFIG_SAMSUNG_GKI_KERNEL is not set

# Disable Samsung SMCDSD panel framework
# theloop uses its own panel drivers (panel_wb_common_lcm via DTS),
# not Samsung's smcdsd_panel framework.
# Without this disabled, mediatek-drm compiles with SMCDSD hooks that
# fail to probe on theloop hardware.
# CONFIG_SMCDSD_PANEL is not set
# CONFIG_SMCDSD_LCD_DEBUG is not set
# CONFIG_SMCDSD_DPUI is not set
# CONFIG_SMCDSD_MDNIE is not set
# CONFIG_SMCDSD_DOZE is not set
# CONFIG_SMCDSD_MASK_LAYER is not set
# CONFIG_SMCDSD_DYNAMIC_MIPI is not set
# CONFIG_SMCDSD_PANEL_A34X is not set
# CONFIG_DRM_PANEL_MCD_COMMON is not set
